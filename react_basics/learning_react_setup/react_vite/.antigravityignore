# .antigravityignore
# Place this in any project root to stop Antigravity indexing these into agent context.
# Prevents thousands of unnecessary tokens being sent to the model on every prompt.

# Dependencies (never needs to be read)
node_modules/
bower_components/
vendor/
.pnp/

# Build artifacts
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
__pycache__/
*.pyc
*.pyo

# Media files (model can't use these)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.mp4
*.mp3
*.wav
*.ico
*.woff
*.woff2
*.ttf
*.eot

# Lock files (redundant with package.json)
package-lock.json
yarn.lock
pnpm-lock.yaml
poetry.lock
Pipfile.lock
composer.lock

# Logs and temp files
*.log
*.tmp
*.temp
logs/
.cache/
tmp/

# IDE and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.suo
*.user

# Test coverage reports (not useful for coding context)
coverage/
.nyc_output/
htmlcov/

# Skills cache (managed by agent, not needed in context)
.skills-cache/
.skills-loaded.json
